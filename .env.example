# Copy to .env — both `npm run dev` and `npm start` read it.
# The key stays in the Node process; the browser only ever sees a ten-minute
# client secret minted from it.
OPENAI_API_KEY=sk-...

# Which voice the picker opens on. ballad, marin, cedar, verse, …
# OPENAI_VOICE=ballad

# Preselected in the model picker when the key can reach it.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Point the proxy at a gateway or a stub instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# PORT=5173
